<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SleepHunter.Controls"
                    xmlns:snapshots="clr-namespace:SleepHunter.Runtime.Snapshots;assembly=SleepHunter.Runtime"
                    xmlns:viewModels="clr-namespace:SleepHunter.ViewModels">
    <ctl:BindingProxy x:Key="UserSettingsManagerProxy"/>

    <!-- Vitals (HP/MP) Progress Bar -->
    <Style x:Key="VitalProgressBar" TargetType="ProgressBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource ObsidianDisabled}"/>
        <Setter Property="Foreground" Value="{DynamicResource ObsidianBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ObsidianSeparatorColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="20"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Name="PART_Track"
                            SnapsToDevicePixels="True"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="{TemplateBinding Padding}"
                              ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}"/>
                            <Border Name="PART_Indicator"
                                    SnapsToDevicePixels="True"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                            <UniformGrid Name="SegmentGrid"
                                         Columns="10"
                                         IsHitTestVisible="False">
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                                <Border BorderBrush="{StaticResource ObsidianControlBackground}" BorderThickness="1,0">
                                    <Border BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}" BorderThickness="1" Margin="0,1"/>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active spell effect duration bar -->
    <Style x:Key="SpellEffectDurationProgressBar"
           TargetType="ProgressBar">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="{StaticResource ObsidianDisabled}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Name="PART_Track"
                          ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}"/>
                        <Border Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active spell effect -->
    <DataTemplate x:Key="ActiveSpellEffectDataTemplate">
        <Border Margin="1">
            <StackPanel Name="EffectVisual"
                        Orientation="Vertical"
                        ToolTip="{Binding ToolTipText}">
                <Image Name="EffectIcon"
                       Width="22"
                       Height="22"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True"
                       Source="{Binding Icon}"/>
                <ProgressBar Name="EffectDurationBar"
                             Style="{StaticResource SpellEffectDurationProgressBar}"
                             Value="{Binding DurationStep, Mode=OneWay}"/>
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DurationStage}"
                         Value="{x:Static snapshots:SpellEffectDurationStage.Blue}">
                <Setter TargetName="EffectDurationBar"
                        Property="Foreground"
                        Value="#666666"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard Name="BlueDurationPulse">
                        <Storyboard AutoReverse="True"
                                    RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="EffectVisual"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1"
                                             To="0.3"
                                             Duration="0:0:0.75"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="BlueDurationPulse"/>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding DurationStage}"
                         Value="{x:Static snapshots:SpellEffectDurationStage.Green}">
                <Setter TargetName="EffectDurationBar"
                        Property="Foreground"
                        Value="#858585"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DurationStage}"
                         Value="{x:Static snapshots:SpellEffectDurationStage.Yellow}">
                <Setter TargetName="EffectDurationBar"
                        Property="Foreground"
                        Value="#A3A3A3"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DurationStage}"
                         Value="{x:Static snapshots:SpellEffectDurationStage.Orange}">
                <Setter TargetName="EffectDurationBar"
                        Property="Foreground"
                        Value="#C2C2C2"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DurationStage}"
                         Value="{x:Static snapshots:SpellEffectDurationStage.Red}">
                <Setter TargetName="EffectDurationBar"
                        Property="Foreground"
                        Value="#E0E0E0"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DurationStage}"
                         Value="{x:Static snapshots:SpellEffectDurationStage.White}">
                <Setter TargetName="EffectDurationBar"
                        Property="Foreground"
                        Value="#FFFFFF"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Client list item data template -->
    <DataTemplate x:Key="ClientListItemDataTemplate"
                  DataType="viewModels:ClientListItemViewModel">
        <DockPanel>
            <Border Name="SelectionBorder" 
                    DockPanel.Dock="Left"
                    Width="4"
                    Background="{DynamicResource ObsidianBackground}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Visibility="Hidden"/>
            <Border Name="Border" Padding="10,4,10,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name -->
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <!-- Running Status Icon -->
                        <TextBlock Name="RunningIcon"
                                   Style="{StaticResource ObsidianSymbolText}"
                                   Text="&#xE102;"
                                   Margin="0"
                                   Visibility="{Binding IsMacroRunning, Converter={StaticResource VisibilityConverter}, ConverterParameter=Collapse}">
                            <TextBlock.Triggers>
                                <!-- Pulse Animation -->
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard>
                                            <Storyboard Duration="0:0:01" RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation From="1" To="0.25" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="RunningIcon"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        
                        <!-- Paused Status Icon -->
                        <TextBlock Name="PausedIcon"
                                   Style="{StaticResource ObsidianSymbolText}"
                                   Text="&#xE103;"
                                   Margin="0"
                                   Visibility="{Binding IsMacroPaused, Converter={StaticResource VisibilityConverter}, ConverterParameter=Collapse}"/>

                        <TextBlock Name="NameText"
                                   Style="{StaticResource ObsidianText}"
                                   Text="{Binding Name}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="4,0"/>
                    </StackPanel>

                    <!-- Hotkey Information -->
                    <Border Name="HotkeyBorder"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderBrush="{StaticResource ObsidianSeparatorColor}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="8"
                        Padding="4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Hidden">
                        <TextBlock Name="HotkeyText"
                                Foreground="{StaticResource ObsidianInactive}"
                                Style="{StaticResource ObsidianText}"
                                Text="{Binding HotkeyString}"
                                FontSize="12"
                                Margin="2,1"
                                FontWeight="Normal"
                                TextAlignment="Center"/>
                    </Border>

                    <!-- Status -->
                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="2" 
                                Orientation="Horizontal">
                        <TextBlock Name="StatusText"
                                   Style="{StaticResource ObsidianText}"
                                   TextWrapping="WrapWithOverflow"
                                   TextAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Margin="4,0"
                                   Opacity="0.7"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Map Location -->
                    <TextBlock Name="MapText"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource ObsidianText}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Margin="4,2"
                           Opacity="0.5">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} ({1}, {2})">
                                <Binding Path="MapName"/>
                                <Binding Path="MapX"/>
                                <Binding Path="MapY"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- HP Bar -->
                    <Border Name="HealthBarContainer"
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            BorderBrush="{StaticResource ObsidianSeparatorColor}"
                            BorderThickness="1"
                            Margin="2,6,2,1">
                        <Grid Name="HealthBarLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>

                            <Border Name="HealthLabelBackground"
                                    Background="{StaticResource ObsidianControlBackground}"
                                    BorderBrush="{StaticResource ObsidianSeparatorColor}"
                                    BorderThickness="0,0,1,0">
                                <TextBlock Name="HealthLabelText"
                                           Style="{StaticResource ObsidianText}"
                                           Text="HP"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <ProgressBar Name="HealthBar"
                                         Grid.Column="1"
                                         Style="{StaticResource VitalProgressBar}"
                                         BorderThickness="0"
                                         Value="{Binding HealthPercent, Mode=OneWay}"/>

                            <Border Name="HealthValueBackground"
                                    Grid.Column="2"
                                    Background="{StaticResource ObsidianControlBackground}"
                                    BorderBrush="{StaticResource ObsidianSeparatorColor}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Name="HealthText"
                                           Style="{StaticResource ObsidianText}"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} / {1}">
                                            <Binding Path="CurrentHealth" Converter="{StaticResource NumericConverter}" ConverterParameter="Thousands"/>
                                            <Binding Path="MaximumHealth" Converter="{StaticResource NumericConverter}" ConverterParameter="Thousands"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- MP Bar -->
                    <Border Name="ManaBarContainer"
                            Grid.Row="4"
                            Grid.ColumnSpan="2"
                            BorderBrush="{StaticResource ObsidianSeparatorColor}"
                            BorderThickness="1"
                            Margin="2,3,2,6">
                        <Grid Name="ManaBarLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>

                            <Border Name="ManaLabelBackground"
                                    Background="{StaticResource ObsidianControlBackground}"
                                    BorderBrush="{StaticResource ObsidianSeparatorColor}"
                                    BorderThickness="0,0,1,0">
                                <TextBlock Name="ManaLabelText"
                                           Style="{StaticResource ObsidianText}"
                                           Text="MP"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <ProgressBar Name="ManaBar"
                                         Grid.Column="1"
                                         Style="{StaticResource VitalProgressBar}"
                                         BorderThickness="0"
                                         Value="{Binding ManaPercent, Mode=OneWay}"/>

                            <Border Name="ManaValueBackground"
                                    Grid.Column="2"
                                    Background="{StaticResource ObsidianControlBackground}"
                                    BorderBrush="{StaticResource ObsidianSeparatorColor}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Name="ManaText"
                                           Style="{StaticResource ObsidianText}"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} / {1}">
                                            <Binding Path="CurrentMana" Converter="{StaticResource NumericConverter}" ConverterParameter="Thousands"/>
                                            <Binding Path="MaximumMana" Converter="{StaticResource NumericConverter}" ConverterParameter="Thousands"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Active Spell Effects -->
                    <ItemsControl Name="SpellEffectsPanel"
                                  Grid.Row="5"
                                  Grid.ColumnSpan="2"
                                  ItemsSource="{Binding ActiveSpellEffects.Effects}"
                                  ItemTemplate="{StaticResource ActiveSpellEffectDataTemplate}"
                                  HorizontalAlignment="Stretch"
                                  Margin="2,1,2,2"
                                  Visibility="Collapsed">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Process Id -->
                    <TextBlock Name="ProcessText"
                           Grid.Row="3"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource ObsidianText}"
                           Text="{Binding Process.ProcessId, StringFormat=Process {0}}"
                           FontSize="14"
                           Opacity="{Binding ElementName=MapText, Path=Opacity}"
                           Margin="4,4,4,1"
                           Visibility="Collapsed"/>

                    <!-- Window Handle -->
                    <TextBlock Name="WindowText"
                           Grid.Row="4"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource ObsidianText}"
                           Text="{Binding Process.WindowHandle, StringFormat=Window {0}}"
                           FontSize="14"
                           Opacity="{Binding ElementName=MapText, Path=Opacity}"
                           Margin="4,1"
                           Visibility="Collapsed"/>
                </Grid>
            </Border>
        </DockPanel>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                <Setter TargetName="NameText" Property="Text" Value="{Binding Process.WindowTitle}"/>
                <Setter TargetName="MapText" Property="Text" Value="Client detected"/>
                <Setter TargetName="HealthBarContainer" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ManaBarContainer" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="StatusText" Property="Text" Value="Not Logged In"/>
                <Setter TargetName="StatusText" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ProcessText" Property="Visibility" Value="Visible"/>
                <Setter TargetName="WindowText" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasHotkey}" Value="True">
                <Setter TargetName="HotkeyBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasActiveSpellEffects}"
                               Value="True"/>
                    <Condition Binding="{Binding Source={StaticResource UserSettingsManagerProxy}, Path=Value.Settings.ShowActiveEffects, Mode=OneWay}"
                               Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SpellEffectsPanel"
                        Property="Visibility"
                        Value="Visible"/>
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter TargetName="SelectionBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
