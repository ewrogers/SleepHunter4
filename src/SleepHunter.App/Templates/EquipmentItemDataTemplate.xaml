<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SleepHunter.Controls">
    <ctl:BindingProxy x:Key="UserSettingsManagerProxy"/>

    <!-- Equipment Item Data Template -->
    <DataTemplate x:Key="EquipmentItemDataTemplate">
        <Border Name="SlotBorder"
                MinWidth="58"
                MinHeight="58"
                Margin="3"
                Padding="2"
                Background="{DynamicResource ObsidianControlBackground}"
                BorderBrush="{DynamicResource ObsidianSeparatorColor}"
                BorderThickness="1"
                CornerRadius="2">
            <Grid>
                <Rectangle Name="EmptyRectangle"
                           Stroke="{DynamicResource ObsidianSeparatorColor}"
                           StrokeThickness="1"
                           StrokeDashArray="8,2"
                           Opacity="0.55"
                           Margin="1"/>

                <Grid ClipToBounds="True"
                      Panel.ZIndex="1">
                    <Image Name="Icon"
                           Width="{Binding Source={StaticResource UserSettingsManagerProxy}, Path=Value.Settings.InventoryIconSize}"
                           Height="{Binding Source={StaticResource UserSettingsManagerProxy}, Path=Value.Settings.InventoryIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           RenderTransformOrigin="0.5,0.5"
                           SnapsToDevicePixels="True"
                           Stretch="None"
                           Source="{Binding Icon}"/>
                </Grid>

                <Border Name="SlotNameBorder"
                        MinWidth="30"
                        Height="14"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="-2"
                        Padding="2,0"
                        Background="{StaticResource ObsidianSeparatorColor}"
                        CornerRadius="0,0,4,0"
                        IsHitTestVisible="False"
                        Opacity="0.45"
                        Panel.ZIndex="2">
                    <TextBlock Text="{Binding Slot, Converter={StaticResource EquipmentSlotConverter}, ConverterParameter=Abbreviation}"
                               Style="{StaticResource ObsidianText}"
                               TextAlignment="Center"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="0,2,0,1"/>
                </Border>
            </Grid>
            <Border.ToolTip>
                <StackPanel Orientation="Vertical">
                    <TextBlock Name="ToolTipNameText"
                               Text="{Binding DisplayName}"
                               Style="{StaticResource ObsidianText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               Margin="4,2"/>
                    <Separator Style="{StaticResource ObsidianSeparator}"
                               Background="{DynamicResource ObsidianForeground}"
                               Margin="1,4"/>
                    <TextBlock Style="{StaticResource ObsidianText}"
                               Text="{Binding Slot, Converter={StaticResource EquipmentSlotConverter}}"
                               FontSize="14"
                               FontWeight="Normal"
                               TextAlignment="Center"
                               Margin="4,2"/>
                    <TextBlock Style="{StaticResource ObsidianText}"
                               Text="{Binding SpriteNumber, StringFormat=Sprite: {0}}"
                               FontSize="14"
                               FontWeight="Normal"
                               TextAlignment="Center"
                               Margin="4,2"/>
                    <TextBlock Name="ToolTipDurabilityText"
                               Style="{StaticResource ObsidianText}"
                               Text="{Binding FormattedDurability, StringFormat=Durability: {0}}"
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="{DynamicResource ObsidianDurability}"
                               TextAlignment="Center"
                               Visibility="Collapsed"
                               Margin="4,2"/>
                </StackPanel>
            </Border.ToolTip>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter TargetName="SlotBorder" Property="ToolTip" Value="{x:Null}"/>
                <Setter TargetName="Icon" Property="Visibility" Value="Hidden"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                <Setter TargetName="EmptyRectangle" Property="Visibility" Value="Hidden"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding HasDurability}" Value="True">
                <Setter TargetName="ToolTipDurabilityText" Property="Visibility" Value="Visible"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Source={StaticResource UserSettingsManagerProxy}, Path=Value.Settings.InventoryIconSize}"
                         Value="62">
                <Setter TargetName="Icon" Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="2" ScaleY="2"/>
                    </Setter.Value>
                </Setter>
            </DataTrigger>

            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsEmpty}" Value="False"/>
                    <Condition Binding="{Binding ElementName=SlotBorder, Path=IsMouseOver}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SlotBorder" Property="BorderBrush" Value="{DynamicResource ObsidianBackground}"/>
                <Setter TargetName="SlotNameBorder" Property="Background" Value="{DynamicResource ObsidianBackground}"/>
                <Setter TargetName="SlotNameBorder" Property="Opacity" Value="0.65"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
