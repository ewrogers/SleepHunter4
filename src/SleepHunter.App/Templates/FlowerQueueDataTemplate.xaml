<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Flower Queue Item Data Template -->
    <DataTemplate x:Key="FlowerQueueItemDataTemplate">
        <DockPanel>
            <Border Name="SelectionBorder" DockPanel.Dock="Left"
                    Width="4"
                    Background="{DynamicResource ObsidianBackground}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Visibility="Hidden"/>
            <Border Name="Border" Padding="10,4">
                <StackPanel Orientation="Vertical">
                    <TextBlock Name="TargetText"
                               Style="{StaticResource ObsidianText}"
                               FontSize="18"
                               Text="{Binding Target, StringFormat=Flowering {0}}"
                               Margin="8,2"/>
                    <StackPanel Margin="8,0,4,2">
                        <TextBlock Name="ConditionLeadText"
                                   Style="{StaticResource ObsidianText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Text="WHEN"
                                   Foreground="{StaticResource ObsidianInactive}"
                                   Margin="0,2"/>
                        <WrapPanel Orientation="Horizontal">
                            <StackPanel Name="IntervalCondition"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,2">
                                <Border Background="{DynamicResource ObsidianBackground}"
                                        BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="1"
                                        Padding="6,2">
                                    <TextBlock Name="TimerKeywordText"
                                               Style="{StaticResource ObsidianText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ObsidianAccentForeground}"
                                               Text="TIMER"/>
                                </Border>
                                <TextBlock Name="IntervalText"
                                           Style="{StaticResource ObsidianText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Text="{Binding Interval, Converter={StaticResource TimeSpanConverter}, ConverterParameter=Fractional, StringFormat=> {0}}"
                                           Foreground="{DynamicResource ObsidianForeground}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>

                            <TextBlock Name="OrText"
                                       Style="{StaticResource ObsidianText}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource ObsidianInactive}"
                                       Text="OR"
                                       Margin="8,2"/>

                            <StackPanel Name="ThresholdCondition"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,2">
                                <Border Background="{DynamicResource ObsidianBackground}"
                                        BorderBrush="{DynamicResource ObsidianAccentInsetBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="1"
                                        Padding="6,2">
                                    <TextBlock Name="ManaKeywordText"
                                               Style="{StaticResource ObsidianText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ObsidianAccentForeground}"
                                               Text="MP"/>
                                </Border>
                                <TextBlock Name="ThresholdText"
                                           Style="{StaticResource ObsidianText}"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           Text="{Binding ManaThreshold, StringFormat=&lt; {0}}"
                                           Foreground="{DynamicResource ObsidianForeground}"
                                           Margin="6,0,0,0"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                    <DockPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,2">
                            <TextBlock Name="RemainingSymbol"
                                       Style="{StaticResource ObsidianSymbolText}"
                                       FontSize="16"
                                       Text="&#xE121;"
                                       Margin="4,4"/>

                            <TextBlock Name="RemainingText"
                                       Style="{StaticResource ObsidianText}"
                                       Text="{Binding RemainingTime, Converter={StaticResource TimeSpanConverter}, ConverterParameter=Cooldown, Mode=OneWay}"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       Margin="2,2"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                <Setter TargetName="SelectionBorder" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding ManaThreshold}" Value="{x:Null}">
                <Setter TargetName="OrText" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ThresholdCondition" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Interval}" Value="{x:Null}">
                <Setter TargetName="IntervalCondition" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="OrText" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="RemainingSymbol" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="RemainingText" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Interval}" Value="0">
                <Setter TargetName="IntervalText" Property="Text" Value="Continuously"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsReady, Mode=OneWay}" Value="True">
                <Setter TargetName="RemainingSymbol" Property="Foreground" Value="{StaticResource ObsidianInactive}"/>
                <Setter TargetName="RemainingText" Property="Foreground" Value="{StaticResource ObsidianInactive}"/>
                <Setter TargetName="RemainingText" Property="Text" Value="Waiting to be Flowered..."/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
